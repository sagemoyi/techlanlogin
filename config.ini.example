[login]
# Campus portal page URL. Replace PORTAL_HOST with your campus portal host/IP.
url = http://PORTAL_HOST/a79.htm?wlanacname=Huawei
# Student/account ID
username = your_student_id
# Password
password = your_password
# ISP suffix; examples vary by campus: @cmcc, @telecom, @unicom, @dx, @lt, or empty.
isp = @cmcc

[settings]
# true = headless background mode, false = show browser window
headless = true
# Selenium element wait timeout in seconds
timeout = 10
# Retry count and delay
retry_count = 3
retry_delay = 5
# Startup delay in seconds, useful when auto-starting after Windows login
startup_delay = 10
